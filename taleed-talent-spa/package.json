{
  "name": "taleed-talent-workspace",
  "private": true,
  "version": "1.0.0-demo",
  "type": "module",
  "engines": {
    "node": "24.10.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:backend": "tsc --noEmit && node scripts/build-backend.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:domain": "node scripts/test-domain.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "versions": "node scripts/record-versions.mjs",
    "bootstrap:latest": "node scripts/bootstrap.mjs",
    "check:source": "node scripts/check-source.mjs",
    "format": "prettier --write src tests e2e scripts docs *.md *.json *.ts",
    "format:check": "prettier --check src tests e2e scripts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@reduxjs/toolkit": "2.12.0",
    "lucide-react": "1.46.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.88.0",
    "react-redux": "9.3.0",
    "react-router-dom": "7.18.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.0.1",
    "prettier": "3.7.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
